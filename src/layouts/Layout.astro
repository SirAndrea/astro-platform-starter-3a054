---
import '../styles/globals.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import poppinsWoff2 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import HamburgerMenu from '../components/HamburgerMenu.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <title>{title} | Rubius es el mejor</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Sitio web dedicado a El Rubius, el mejor streamer y youtuber de habla hispana" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={poppinsWoff2} crossorigin />
    </head>
    <body class="antialiased text-gray-900">
        <!-- Particle canvas background -->
        <canvas id="particle-canvas"></canvas>

        <HamburgerMenu />
        <div class="min-h-screen flex flex-col relative z-10">
            <main class="flex-grow">
                <slot />
            </main>
            <footer class="py-6 text-center text-gray-300 text-sm border-t border-purple-700/30">
                <p>Página de fan dedicada a El Rubius</p>
            </footer>
        </div>

        <script>
            const canvas = document.getElementById('particle-canvas') as HTMLCanvasElement;
            const ctx = canvas.getContext('2d')!;

            let particles: Particle[] = [];
            let mouseX = -1000;
            let mouseY = -1000;
            const PARTICLE_COUNT = 80;
            const GLOW_RADIUS = 150;

            interface Particle {
                x: number;
                y: number;
                vx: number;
                vy: number;
                size: number;
                baseAlpha: number;
                alpha: number;
                glowing: boolean;
            }

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = Math.max(document.body.scrollHeight, window.innerHeight);
            }

            function createParticle(): Particle {
                return {
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    vx: (Math.random() - 0.5) * 0.5,
                    vy: (Math.random() - 0.5) * 0.5,
                    size: Math.random() * 3 + 1,
                    baseAlpha: Math.random() * 0.4 + 0.2,
                    alpha: 0.3,
                    glowing: false
                };
            }

            function initParticles() {
                particles = [];
                for (let i = 0; i < PARTICLE_COUNT; i++) {
                    particles.push(createParticle());
                }
            }

            function drawParticle(p: Particle) {
                const dist = Math.sqrt((p.x - mouseX) ** 2 + (p.y - mouseY) ** 2);
                const isNearMouse = dist < GLOW_RADIUS;

                if (isNearMouse) {
                    const intensity = 1 - (dist / GLOW_RADIUS);
                    p.alpha = Math.min(1, p.baseAlpha + intensity * 0.8);
                    p.glowing = true;
                } else {
                    p.alpha = p.baseAlpha;
                    p.glowing = false;
                }

                ctx.beginPath();

                if (p.glowing) {
                    // Glow effect
                    const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.size * 4);
                    gradient.addColorStop(0, `rgba(57, 255, 20, ${p.alpha})`);
                    gradient.addColorStop(0.5, `rgba(57, 255, 20, ${p.alpha * 0.5})`);
                    gradient.addColorStop(1, 'rgba(57, 255, 20, 0)');
                    ctx.fillStyle = gradient;
                    ctx.arc(p.x, p.y, p.size * 4, 0, Math.PI * 2);
                } else {
                    ctx.fillStyle = `rgba(57, 255, 20, ${p.alpha})`;
                    ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                }

                ctx.fill();

                // Core of the particle
                ctx.beginPath();
                ctx.fillStyle = `rgba(180, 255, 150, ${p.alpha})`;
                ctx.arc(p.x, p.y, p.size * 0.5, 0, Math.PI * 2);
                ctx.fill();
            }

            function updateParticle(p: Particle) {
                p.x += p.vx;
                p.y += p.vy;

                // Wrap around screen
                if (p.x < 0) p.x = canvas.width;
                if (p.x > canvas.width) p.x = 0;
                if (p.y < 0) p.y = canvas.height;
                if (p.y > canvas.height) p.y = 0;
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);

                particles.forEach(p => {
                    updateParticle(p);
                    drawParticle(p);
                });

                requestAnimationFrame(animate);
            }

            // Track mouse position
            document.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY + window.scrollY;
            });

            document.addEventListener('mouseleave', () => {
                mouseX = -1000;
                mouseY = -1000;
            });

            // Handle resize
            window.addEventListener('resize', () => {
                resizeCanvas();
            });

            // Handle scroll to update canvas height
            window.addEventListener('scroll', () => {
                const newHeight = Math.max(document.body.scrollHeight, window.innerHeight);
                if (canvas.height !== newHeight) {
                    canvas.height = newHeight;
                }
            });

            // Initialize
            resizeCanvas();
            initParticles();
            animate();
        </script>
    </body>
</html>

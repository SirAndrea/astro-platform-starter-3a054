---
import '../styles/globals.css';
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import poppinsWoff2 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import HamburgerMenu from '../components/HamburgerMenu.astro';

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <title>{title} | Rubius es el mejor</title>
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content="Sitio web dedicado a El Rubius, el mejor streamer y youtuber de habla hispana" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={poppinsWoff2} crossorigin />
    </head>
    <body class="antialiased animated-bg text-gray-900">
        <canvas id="particles-canvas"></canvas>
        <HamburgerMenu />
        <div class="min-h-screen flex flex-col relative z-10">
            <main class="flex-grow relative z-10">
                <slot />
            </main>
            <footer class="py-6 text-center text-gray-500 text-sm border-t border-gray-200 bg-white/50 backdrop-blur-sm relative z-10">
                <p>Fan page dedicada a El Rubius</p>
            </footer>
        </div>

        <script>
            // Interactive particle system with fluorescent green
            const canvas = document.getElementById('particles-canvas') as HTMLCanvasElement;
            const ctx = canvas.getContext('2d');

            let particles: Array<{
                x: number;
                y: number;
                vx: number;
                vy: number;
                radius: number;
                color: string;
                alpha: number;
            }> = [];

            let mouseX = 0;
            let mouseY = 0;
            let isMouseMoving = false;
            let mouseTimeout: ReturnType<typeof setTimeout>;

            const fluorGreen = '#39ff14';
            const violet = '#a855f7';
            const lightViolet = '#e9d5ff';

            function resizeCanvas() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            }

            function createParticle(x: number, y: number) {
                const colors = [fluorGreen, violet, lightViolet, '#7c3aed'];
                return {
                    x: x + (Math.random() - 0.5) * 100,
                    y: y + (Math.random() - 0.5) * 100,
                    vx: (Math.random() - 0.5) * 2,
                    vy: (Math.random() - 0.5) * 2,
                    radius: Math.random() * 4 + 1,
                    color: colors[Math.floor(Math.random() * colors.length)],
                    alpha: Math.random() * 0.8 + 0.2
                };
            }

            function initParticles() {
                particles = [];
                const numParticles = Math.floor((canvas.width * canvas.height) / 15000);
                for (let i = 0; i < numParticles; i++) {
                    particles.push(createParticle(
                        Math.random() * canvas.width,
                        Math.random() * canvas.height
                    ));
                }
            }

            function animate() {
                if (!ctx) return;

                ctx.clearRect(0, 0, canvas.width, canvas.height);

                particles.forEach((p, index) => {
                    // Move towards mouse when moving
                    if (isMouseMoving) {
                        const dx = mouseX - p.x;
                        const dy = mouseY - p.y;
                        const dist = Math.sqrt(dx * dx + dy * dy);

                        if (dist < 200) {
                            p.vx += dx * 0.0005;
                            p.vy += dy * 0.0005;
                            p.alpha = Math.min(1, p.alpha + 0.02);
                        }
                    }

                    // Apply velocity
                    p.x += p.vx;
                    p.y += p.vy;

                    // Friction
                    p.vx *= 0.99;
                    p.vy *= 0.99;

                    // Fade out slowly
                    if (!isMouseMoving) {
                        p.alpha *= 0.995;
                    }

                    // Wrap around screen
                    if (p.x < 0) p.x = canvas.width;
                    if (p.x > canvas.width) p.x = 0;
                    if (p.y < 0) p.y = canvas.height;
                    if (p.y > canvas.height) p.y = 0;

                    // Draw particle
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.globalAlpha = p.alpha;
                    ctx.fill();

                    // Draw glow for fluorescent green
                    if (p.color === fluorGreen) {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.radius * 2, 0, Math.PI * 2);
                        const gradient = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius * 3);
                        gradient.addColorStop(0, `rgba(57, 255, 20, ${p.alpha * 0.5})`);
                        gradient.addColorStop(1, 'rgba(57, 255, 20, 0)');
                        ctx.fillStyle = gradient;
                        ctx.fill();
                    }
                });

                ctx.globalAlpha = 1;

                // Add new particles near mouse
                if (isMouseMoving && particles.length < 300) {
                    particles.push(createParticle(mouseX, mouseY));
                }

                requestAnimationFrame(animate);
            }

            // Event listeners
            window.addEventListener('resize', () => {
                resizeCanvas();
                initParticles();
            });

            document.addEventListener('mousemove', (e) => {
                mouseX = e.clientX;
                mouseY = e.clientY;
                isMouseMoving = true;

                clearTimeout(mouseTimeout);
                mouseTimeout = setTimeout(() => {
                    isMouseMoving = false;
                }, 100);
            });

            // Initialize
            resizeCanvas();
            initParticles();
            animate();
        </script>
    </body>
</html>

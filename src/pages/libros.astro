---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sus Libros">
    <div class="py-20 px-6">
        <div class="max-w-6xl mx-auto">
            <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-8 text-center">
                Los Libros de El Rubius
            </h1>
            <div class="w-24 h-1 bg-pink-500 mx-auto mb-12"></div>

            <p class="text-lg text-gray-700 text-center mb-12 max-w-2xl mx-auto">
                El Rubius ha demostrado que su talento va mas alla de los videos. Sus libros han
                conquistado a millones de lectores en todo el mundo hispanohablante.
            </p>

            <!-- Libros Grid -->
            <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
                <!-- 1. Libro Troll -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/libro-troll.webp"
                            alt="El Libro Troll"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-pink-100 text-pink-700 rounded-full text-xs font-medium">
                            Bestseller
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">El Libro Troll</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2014
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        El primer libro de El Rubius fue todo un fenomeno editorial. Combinando humor,
                        ilustraciones y actividades interactivas.
                    </p>
                </article>

                <!-- 2. Virtual Hero -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/virtual-hero.webp"
                            alt="Virtual Hero"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-purple-100 text-purple-700 rounded-full text-xs font-medium">
                            Comic / Serie
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Virtual Hero</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2015
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Comic y serie animada donde Rubius vive aventuras en un mundo virtual lleno de
                        desafios y enemigos.
                    </p>
                </article>

                <!-- 3. Virtual Hero: La Torre Imposible -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/virtual-hero-torre-imposible.jpg"
                            alt="Virtual Hero: La Torre Imposible"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs font-medium">
                            Comic
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Virtual Hero: La Torre Imposible</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2016
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Segunda entrega de la saga Virtual Hero. Rubius debe superar la misteriosa
                        Torre Imposible.
                    </p>
                </article>

                <!-- 4. Virtual Hero: La Mascara del Troll -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/virtual-hero-mascara-troll.webp"
                            alt="Virtual Hero: La Mascara del Troll"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-cyan-100 text-cyan-700 rounded-full text-xs font-medium">
                            Comic
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Virtual Hero: La Mascara del Troll</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2017
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Tercera entrega de Virtual Hero. Rubius enfrenta nuevos enemigos y descubre
                        secretos oscuros.
                    </p>
                </article>

                <!-- 5. Escuela de Gamers -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/escuela-de-gamers.jpg"
                            alt="Escuela de Gamers"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-medium">
                            Novela
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Escuela de Gamers</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2017
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Una aventura donde Rubius ingresa a una escuela secreta para gamers con
                        misterios por resolver.
                    </p>
                </article>

                <!-- 6. Gamedonia (Escuela de Gamers 2) -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/gamedonia.jpg"
                            alt="Gamedonia - Escuela de Gamers 2"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-pink-100 text-pink-700 rounded-full text-xs font-medium">
                            Novela
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Gamedonia</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2018
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Segunda parte de Escuela de Gamers. Rubius y sus amigos descubren el mundo
                        de Gamedonia.
                    </p>
                </article>

                <!-- 7. Real Hero (Escuela de Gamers 3) -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/real-hero.jpeg"
                            alt="Real Hero - Escuela de Gamers 3"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-orange-100 text-orange-700 rounded-full text-xs font-medium">
                            Novela
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Real Hero</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2019
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Tercera y emocionante parte de la saga Escuela de Gamers. La batalla final
                        por salvar todo.
                    </p>
                </article>

                <!-- 8. Rubius Japon 2009 -->
                <article class="bg-gray-50 rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                    <div class="mb-4 flex justify-center">
                        <img
                            src="/images/rubius-japon-2009.jpg"
                            alt="Rubius Japon 2009"
                            class="w-full h-64 object-cover rounded-lg shadow-md"
                        />
                    </div>
                    <div class="mb-3">
                        <span class="inline-block px-2 py-1 bg-red-100 text-red-700 rounded-full text-xs font-medium">
                            Viajes
                        </span>
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 mb-2">Rubius Japon 2009</h3>
                    <p class="text-gray-600 text-sm mb-3">
                        <strong>Ano:</strong> 2025
                    </p>
                    <p class="text-gray-700 text-sm leading-relaxed">
                        Las aventuras de El Rubius durante su primer viaje a Japon en 2009, con
                        fotos y anecdotas unicas.
                    </p>
                </article>
            </div>

            <!-- Additional Info Section -->
            <section class="mt-16 bg-white rounded-xl p-8 border border-gray-200">
                <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">Impacto Literario</h2>
                <div class="grid md:grid-cols-3 gap-6 text-center">
                    <div>
                        <p class="text-4xl font-bold text-pink-500 mb-2">+1M</p>
                        <p class="text-gray-600">Copias vendidas</p>
                    </div>
                    <div>
                        <p class="text-4xl font-bold text-pink-500 mb-2">20+</p>
                        <p class="text-gray-600">Paises</p>
                    </div>
                    <div>
                        <p class="text-4xl font-bold text-pink-500 mb-2">#1</p>
                        <p class="text-gray-600">Bestseller en Espana</p>
                    </div>
                </div>
            </section>

            <div class="mt-12 text-center">
                <a href="/" class="btn">Volver al Inicio</a>
            </div>
        </div>
    </div>
</Layout>
